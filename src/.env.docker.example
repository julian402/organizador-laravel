# Variables para el contenedor. Copiar a .env.docker y completar.
#   docker run -d -p 80:80 --env-file .env.docker organizador-app
APP_NAME=Organizador
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=es

LOG_CHANNEL=stderr

DB_CONNECTION=pgsql
# Local (Docker Desktop): host.docker.internal | AWS: IP privada de la EC2 de BD
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=organizador
DB_USERNAME=organizador
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log

# true = ejecuta las migraciones al arrancar el contenedor
RUN_MIGRATIONS=false
