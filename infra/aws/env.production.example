# Reemplace APP_URL (IP publica o dominio), DB_HOST (IP privada de la BD) y DB_PASSWORD antes del segundo paso.
APP_NAME=Organizador
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=<IP-PRIVADA-EC2-BD>
DB_PORT=5432
DB_DATABASE=organizador
DB_USERNAME=organizador
DB_PASSWORD=<CLAVE-SEGURA>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Con HTTPS: APP_URL=https://<dominio> y
# SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# MAIL_MAILER=log solo escribe el correo en el log (y con LOG_LEVEL=warning ni eso).
# Para enviar de verdad (Gmail con contraseña de aplicación):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=<correo>@gmail.com
# MAIL_PASSWORD=<contraseña-de-aplicación>
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@organizador.local"
MAIL_FROM_NAME="${APP_NAME}"
