APP_NAME=Organizador
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://<IP-PUBLICA-O-DOMINIO>

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=<IP-PRIVADA-EC2-BD>
DB_PORT=5432
DB_DATABASE=organizador
DB_USERNAME=organizador
DB_PASSWORD=<CLAVE-SEGURA>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@organizador.local"
MAIL_FROM_NAME="${APP_NAME}"
